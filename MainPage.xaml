<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculator.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label Text="Conta"/>

            <Entry Placeholder="Ensira o Valor" Keyboard="Numeric" />

            <Label x:Name="ValorRealLabel" Text="R$: 0.00"/>

            <Label Text="Valor da Gorjeta" />

            <Label Text="0.00" />

            <Label Text="Porcentagem da Gorjeta"/>

            <Label x:Name="PorcentagemGorjetaLabel" Text="0"/>
            <Slider 
                x:Name="TipPercentSlider" 
                Minimum="0" 
                Maximum="100" 
                ValueChanged="TrocaDeValorDoSlider"
                SemanticProperties.Description="Porcentagem da Gorjeta"/>

            <Button Text="15" Clicked="Gorjeta15PorcentagemButton_Clicked"  />
            <Button Text="20%" Clicked="Gorjeta20PorcentagemButton_Clicked"/>
            
            <Button x:Name="RoundDown" Text="Round Down" />
            <Button x:Name="RoundUp" Text="Round Up" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
